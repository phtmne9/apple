---
import Header from '../components/Header.astro';
import { locales, defaultLocale, type Locale } from '../i18n/ui';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  description: string;
  extraJsonLd?: Record<string, unknown>;
  overlayHeader?: boolean;
}

const { locale, slug, title, description, extraJsonLd, overlayHeader = false } = Astro.props;

const pathFor = (loc: Locale) => withBase(`/${loc}/${slug ? `${slug}/` : ''}`);
const canonicalURL = new URL(pathFor(locale), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet" />
    <style set:html={`
      @font-face {
        font-family: "General Sans";
        src: url('${withBase('/fonts/general-sans/GeneralSans-Regular.woff2')}') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url('${withBase('/fonts/general-sans/GeneralSans-Medium.woff2')}') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url('${withBase('/fonts/general-sans/GeneralSans-Semibold.woff2')}') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url('${withBase('/fonts/general-sans/GeneralSans-Bold.woff2')}') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    `} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {locales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={new URL(pathFor(loc), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLocale === 'ru' ? 'en' : defaultLocale), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: locale === 'en' ? "Sievers' Apple Grove" : locale === 'kk' ? 'Сиверс алмасы алаңы' : 'Роща яблони Сиверса',
      description,
      containedInPlace: {
        '@type': 'Park',
        name: 'Ile-Alatau State National Natural Park',
        url: 'https://www.ile-alatau.kz/',
      },
    })} />

    {extraJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === 'en' ? 'Skip to content' : locale === 'kk' ? 'Мазмұнға өту' : 'Перейти к содержанию'}
    </a>
    <Header locale={locale} slug={slug} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <script>
      const revealed = document.querySelectorAll('[data-reveal]');
      if (revealed.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        revealed.forEach((el) => observer.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-visible'));
      }

      const heroVideo = document.querySelector('.hero__video');
      if (heroVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
        heroVideo.pause();
        heroVideo.removeAttribute('autoplay');
      }

      const scrollVideos = document.querySelectorAll('video[data-scroll-play]');
      if (scrollVideos.length && 'IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const video = entry.target;
                video.currentTime = 0;
                video.play().catch(() => {});
              }
            }
          },
          { threshold: 0.35 }
        );
        scrollVideos.forEach((video) => videoObserver.observe(video));
      }

      const overlayHeader = document.querySelector('.site-header--overlay');
      if (overlayHeader) {
        const toggleScrolled = () => {
          overlayHeader.classList.toggle('is-scrolled', window.scrollY > 60);
        };
        toggleScrolled();
        window.addEventListener('scroll', toggleScrolled, { passive: true });
      }
    </script>
  </body>
</html>
