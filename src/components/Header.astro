---
import { locales, languageNames, ui, type Locale } from '../i18n/ui';
import { home } from '../i18n/home';
import { pagePath } from '../lib/paths';

interface Props {
  locale: Locale;
  slug: string;
  overlay?: boolean;
}
const { locale, slug, overlay = false } = Astro.props;

const t = ui[locale];
const pills = home[locale].navPills;

const pillList: Array<{ id: string; label: string }> = [
  { id: 'species', label: pills.species },
  { id: 'trail', label: pills.trail },
  { id: 'involve', label: pills.involve },
];
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="site-header__inner">
    <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label={t.switchLanguage}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <div class="site-nav-wrap" id="mobile-nav" data-nav-panel>
      <nav class="site-nav" aria-label={t.siteName}>
        {pillList.map((pill) => (
          <a href={`${pagePath(locale)}#${pill.id}`}>{pill.label}</a>
        ))}
      </nav>

      <div class="lang-switch" role="group" aria-label={t.switchLanguage}>
        {locales.map((loc) => (
          <a href={pagePath(loc, slug)} aria-current={loc === locale ? 'true' : undefined}>
            {languageNames[loc]}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="nav-backdrop" data-nav-backdrop></div>
</header>

<script>
  function initNavToggle(header: HTMLElement) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-nav-panel]');
    const backdrop = header.querySelector<HTMLElement>('[data-nav-backdrop]');
    if (!toggle || !panel || !backdrop) return;

    const close = () => {
      panel.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open-lock');
    };
    const open = () => {
      panel.classList.add('is-open');
      backdrop.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('nav-open-lock');
    };

    toggle.addEventListener('click', () => {
      if (panel.classList.contains('is-open')) close();
      else open();
    });
    backdrop.addEventListener('click', close);
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  document.querySelectorAll<HTMLElement>('.site-header').forEach(initNavToggle);
</script>
