---
import type { VisitRulesCopy, RuleIcon } from '../i18n/visitRules';

interface Props {
  copy: VisitRulesCopy;
}
const { copy } = Astro.props;

// Icon paths from Lucide (lucide.dev, ISC license) — flame, trees, flower-2, trash-2, paw-print, map-pin.
const glyphs: Record<RuleIcon, string> = {
  fire: '<path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" />',
  branch: '<path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z" /><path d="M7 16v6" /><path d="M13 19v3" /><path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5" />',
  flower: '<path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1" /><circle cx="12" cy="8" r="2" /><path d="M12 10v12" /><path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z" /><path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z" />',
  litter: '<path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />',
  harm: '<circle cx="11" cy="4" r="2" /><circle cx="18" cy="8" r="2" /><circle cx="20" cy="16" r="2" /><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />',
  route: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" />',
};
---

<div class="rules-cards">
  <div class="rules-cards__viewport">
    <button type="button" class="rules-cards__nav rules-cards__nav--prev" data-dir="-1" aria-label="Previous">
      <svg viewBox="0 0 24 24" width="20" height="20"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <div class="rules-cards__track" data-track>
      {copy.rules.map((rule) => (
        <div class="rule-card">
          <div class="rule-card__icon">
            <svg class="rule-card__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[rule.icon]} />
          </div>
          <p class="rule-card__text">{rule.text}</p>
        </div>
      ))}
    </div>

    <button type="button" class="rules-cards__nav rules-cards__nav--next" data-dir="1" aria-label="Next">
      <svg viewBox="0 0 24 24" width="20" height="20"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

  <p class="rules-cards__outro">{copy.outro}</p>
</div>

<script>
  function initRulesCards(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    root.querySelectorAll<HTMLButtonElement>('.rules-cards__nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir);
        const card = track.querySelector<HTMLElement>('.rule-card');
        const step = card ? card.getBoundingClientRect().width + 16 : 240;
        track.scrollBy({ left: dir * step * 2, behavior: 'smooth' });
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.rules-cards').forEach(initRulesCards);
</script>

<style>
  .rules-cards {
    margin: 1.8rem 0 0.5rem;
    text-align: center;
  }
  .rules-cards__viewport {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .rules-cards__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0.2rem 0.1rem 0.6rem;
    margin: 0 auto;
  }
  .rules-cards__track::-webkit-scrollbar { display: none; }

  .rule-card {
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    width: clamp(160px, 21vw, 210px);
    text-align: left;
    background: linear-gradient(135deg, #D8EAAE 0%, #B6D67F 100%);
    border: none;
    border-radius: 16px;
    padding: 1.3rem 1.1rem 1.2rem;
    box-shadow: 0 10px 24px -10px rgba(20, 30, 10, 0.4);
  }
  .rule-card__icon {
    position: relative;
    width: 38px;
    height: 38px;
    margin-bottom: 0.9rem;
    color: #3D5A28;
  }
  .rule-card__glyph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rule-card__text {
    margin: 0;
    font-family: "Unbounded", var(--font-display);
    font-size: 0.82rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #2E4419;
    font-weight: 600;
  }

  .rules-cards__nav {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.25);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .rules-cards__nav:hover { border-color: #9fdcae; }

  .rules-cards__outro {
    max-width: 640px;
    margin: 1.6rem auto 0;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 640px) {
    .rules-cards__viewport { position: relative; }
    .rules-cards__track { padding: 0.2rem 0 0.6rem; }
    .rule-card { width: 100%; }
    .rules-cards__nav {
      position: absolute;
      top: 50%;
      z-index: 2;
      transform: translateY(-50%);
      border: none;
      background: none;
      box-shadow: none;
      color: rgba(46, 68, 25, 0.45);
    }
    .rules-cards__nav--prev { left: 0.2rem; }
    .rules-cards__nav--next { right: 0.2rem; }
    .rules-cards__nav:hover { color: rgba(46, 68, 25, 0.75); }
    .rules-cards__outro { color: var(--ink-muted); }
  }

  @media (min-width: 900px) {
    .rules-cards__nav { display: none; }
    .rules-cards__track {
      display: grid;
      grid-template-columns: repeat(2, minmax(160px, 210px));
      grid-auto-flow: column;
      grid-template-rows: repeat(3, auto);
      justify-content: space-between;
      row-gap: 1rem;
      overflow: visible;
      scroll-snap-type: none;
      width: 100%;
      max-width: 1150px;
      padding: 0.2rem 0 0.6rem;
    }
    .rule-card { width: auto; }
  }
</style>
